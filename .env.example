# The catalog's one admin: whoever signs in with these on the Admin page changes the kit from the
# catalog (variables everywhere; files too with `npm start`). Copy to .env (never in the repo) and
# set both: without them nobody can sign in and nothing is saved.
KIT_ADMIN_USER=
KIT_ADMIN_PASSWORD=

# Behind a reverse proxy that speaks https (the deployed image): the session's cookie becomes Secure.
# TRUST_PROXY=true
