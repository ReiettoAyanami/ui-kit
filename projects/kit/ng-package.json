{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/kit",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "allowedNonPeerDependencies": [],
  "assets": [
    {
      "input": "src/styles",
      "glob": "**/*",
      "output": "styles"
    },
    {
      "input": "src/lib",
      "glob": "**/*.md",
      "output": "docs/lib"
    },
    {
      "input": "charts/src",
      "glob": "**/*.md",
      "output": "docs/charts"
    },
    {
      "input": "three/src",
      "glob": "**/*.md",
      "output": "docs/three"
    },
    {
      "input": "http/src",
      "glob": "**/*.md",
      "output": "docs/http"
    },
    {
      "input": ".",
      "glob": "{RULES,AI-RULES}.md",
      "output": "."
    },
    {
      "input": ".",
      "glob": "libraries.json",
      "output": "."
    }
  ]
}
