{
  "name": "@lenzi/ui-kit",
  "version": "0.1.0",
  "description": "lenzi's component kit: Angular Material 3, heavily modified (dark violet, glass, 2 px borders, Apple's SF), with the rules and the AI notes of every component.",
  "license": "Unlicense",
  "peerDependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.0",
    "echarts": "^6.1.0",
    "ngx-echarts": "^21.0.0",
    "three": ">=0.170.0"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    },
    "ngx-echarts": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    "./styles/*": {
      "default": "./styles/*"
    }
  },
  "schematics": "./schematics/collection.json",
  "ng-add": {
    "save": "dependencies"
  }
}
